rules_version = '2';

// =====================================================================
// Reglas de seguridad de Firestore · Plataforma de cursos
// Copia este archivo completo en Firebase → Firestore Database → Reglas
// y presiona «Publicar».
// =====================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // ▼▼▼ ESCRIBE AQUÍ TU CORREO DE INSTRUCTOR, EN MINÚSCULAS (el mismo de js/config.js) ▼▼▼
    function isInstructor() {
      return signedIn() && (
        request.auth.token.email.lower() in [
          'tu_correo_de_instructor@gmail.com'
        ]
        // administradores adicionales, editables desde Administrar curso → Curso
        || request.auth.token.email.lower() in get(/databases/$(database)/documents/config/course).data.info.get('admins', [])
      );
    }
    // ▲▲▲ ----------------------------------------------------------------------- ▲▲▲

    // Contenido del curso: todos lo leen, solo el instructor lo edita.
    match /config/{doc} {
      allow read: if true;
      allow write: if isInstructor();
    }

    // Perfiles
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isInstructor());
      allow create: if signedIn() && request.auth.uid == uid
                    && (request.resource.data.role == 'aprendiz' || isInstructor());
      allow update: if isInstructor()
                    || (signedIn() && request.auth.uid == uid
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'email']));
      allow delete: if isInstructor();
    }

    // Directorio de participantes (nombre, ficha, municipio): lo ven todos los inscritos.
    match /directory/{uid} {
      allow read: if signedIn();
      allow write: if isInstructor() || (signedIn() && request.auth.uid == uid
                      && (!('role' in request.resource.data) || request.resource.data.role == 'aprendiz'));
    }

    // Calificaciones: cada aprendiz solo ve las suyas (documento = su correo con «,» en vez de «.»).
    match /grades/{key} {
      allow read: if isInstructor()
                  || (signedIn() && key == request.auth.token.email.lower().replace('[.]', ','));
      allow write: if isInstructor();
    }

    // Chat general
    match /chat/{msgId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 600
                    && request.resource.data.ts == request.time;
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isInstructor());
    }

    // Mensajes privados: cada aprendiz solo su hilo; el instructor todos.
    match /dm/{uid} {
      allow read, write: if signedIn() && (request.auth.uid == uid || isInstructor());
      match /messages/{msgId} {
        allow read: if signedIn() && (request.auth.uid == uid || isInstructor());
        allow create: if signedIn() && (request.auth.uid == uid || isInstructor())
                      && request.resource.data.uid == request.auth.uid
                      && request.resource.data.text.size() <= 600;
        allow delete: if isInstructor();
      }
    }

    // Reportes del chat
    match /reports/{id} {
      allow create: if signedIn() && request.resource.data.byUid == request.auth.uid;
      allow read, delete: if isInstructor();
    }

    // Entregas: el aprendiz crea/actualiza solo la suya (sin tocar la revisión); el instructor revisa.
    match /subs/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isInstructor());
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
                    && id == request.auth.uid + '_' + request.resource.data.rapId
                    && !('rev' in request.resource.data);
      allow update: if signedIn() && resource.data.uid == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['link', 'comment', 'late', 'ts', 'intentos', 'name', 'ficha', 'email']);
      allow write: if isInstructor();
    }

    // Resultados de actividades interactivas (autocalificables)
    match /results/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isInstructor());
      allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid
                            && id == request.auth.uid + '_' + request.resource.data.actId;
      allow delete: if isInstructor();
    }

    // Anuncios
    match /announcements/{id} {
      allow read: if signedIn();
      allow write: if isInstructor();
    }
  }
}
